# Copy this file to .env and fill in your own credentials.
# .env is git-ignored; never commit real keys to this file.

GITHUB_TOKEN=ghp_your_github_personal_access_token_here

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here


# --- Google Sheets export ---
# Path to a Google Cloud service-account JSON key with Sheets + Drive API enabled
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_NAME=AI Landscape Tracker

# --- Scraper tuning ---
MAX_CONCURRENT_REQUESTS=8
REQUEST_TIMEOUT_SECONDS=30
FRESHNESS_WINDOW_HOURS=24
